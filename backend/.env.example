# Copy to .env and add a token from your football-data.org account.
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_TIMEOUT_SECONDS=10.0
DATABASE_PATH=data/epl-dashboard.sqlite3
STANDINGS_REFRESH_INTERVAL_SECONDS=43200
# Configurable recovery default; a provider Retry-After value can extend this delay.
STANDINGS_FAILURE_RETRY_SECONDS=900

FIXTURES_REFRESH_INTERVAL_SECONDS=21600
FIXTURES_ACTIVE_INTERVAL_SECONDS=1800
FIXTURES_FAILURE_RETRY_SECONDS=900
